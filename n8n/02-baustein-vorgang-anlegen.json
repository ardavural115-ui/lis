    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prüft die Angaben, bevor ein Vorgang angelegt wird.\n// Fehler gehen als Text an die KI zurück, damit sie gezielt nachfragen kann.\nconst ANLIEGEN = ['Rezept', 'Termin', 'Überweisung', 'Krankschreibung', 'Befund', 'Frage', 'Notfall'];\nconst input = $input.item.json;\nconst text = (value) => (value === null || value === undefined ? '' : String(value).trim());\n\nfunction normalizeDate(value) {\n  const match = value.match(/^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})$/);\n  if (!match) return '';\n  const [day, month, year] = match.slice(1).map(Number);\n  const date = new Date(Date.UTC(year, month - 1, day));\n  const valid =\n    date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day &&\n    year >= 1900 && date <= new Date();\n  return valid ? String(day).padStart(2, '0') + '.' + String(month).padStart(2, '0') + '.' + year : '';\n}\n\nconst anliegen = ANLIEGEN.find((a) => a.toLowerCase() === text(input.anliegen).toLowerCase()) ?? '';\nconst name = text(input.name);\nconst telefon = text(input.telefon);\nconst geburtsdatum = normalizeDate(text(input.geburtsdatum));\n\nconst fehler = [];\nif (!anliegen) fehler.push('Anliegen muss eines davon sein: ' + ANLIEGEN.slice(0, 6).join(', '));\nif (anliegen !== 'Notfall') {\n  if (name.split(/\\s+/).filter(Boolean).length < 2) fehler.push('vollständiger Name (Vor- und Nachname)');\n  if (!geburtsdatum) fehler.push('gültiges Geburtsdatum im Format TT.MM.JJJJ');\n  if (telefon.replace(/\\D/g, '').length < 6) fehler.push('gültige Telefonnummer');\n}\nif (fehler.length > 0) {\n  return { json: { ok: false, fehler: 'Vorgang nicht angelegt. Bitte nachfragen: ' + fehler.join('; ') + '.' } };\n}\n\nconst heute = $now.toFormat('yyyyMMdd'); // Datum in der Zeitzone des Workflows (Europe/Berlin)\nconst zufall = Math.random().toString(36).slice(2, 6).toUpperCase().padEnd(4, 'X');\n\nreturn {\n  json: {\n    ok: true,\n    vorgangsnummer: 'V-' + heute + '-' + zufall,\n    anliegen,\n    status: 'neu',\n    dringend: input.dringend === true || input.dringend === 'true' || anliegen === 'Notfall',\n    name,\n    geburtsdatum,\n    telefon,\n    details: text(input.details).slice(0, 2000),\n    zusammenfassung: text(input.zusammenfassung).slice(0, 500),\n    sessionId: text(input.sessionId),\n    kanal: text(input.kanal) || 'chat',\n  },\n};"
      },
