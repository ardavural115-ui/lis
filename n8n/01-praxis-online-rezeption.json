            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "e7864645-3261-4d70-a927-19cdf65c5483",
      "name": "Antwort: Notfall",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        -360
